RewriteEngine On

# Redirige tout vers public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?page=$1 [QSA,L]

# Bloque l'accès direct aux dossiers sensibles
RewriteRule ^app/ - [F,L]
RewriteRule ^config/ - [F,L]

# Désactive l'affichage du contenu des dossiers
Options -Indexes